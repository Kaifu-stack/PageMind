{
    "manifest_version": 3,
    "name": "PageMind",
    "version": "1.0.0",
    "description": "Summarize and chat with videos, articles, products, and web pages.",
    "permissions": [
        "activeTab",
        "tabs",
        "scripting"
    ],
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "contentScript.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "host_permissions": [
        "http://127.0.0.1:8000/*",
        "https://pagemind-backend.onrender.com/*",
        "https://www.youtube.com/*",
        "https://youtu.be/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "index.html",
        "default_icon": {
            "16": "logo16.png",
            "32": "logo32.png",
            "48": "logo48.png",
            "128": "logo128.png"
        }
    },
    "icons": {
        "16": "logo16.png",
        "32": "logo32.png",
        "48": "logo48.png",
        "128": "logo128.png"
    }
}